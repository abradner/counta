# Keep the build context small and out of the image: none of this is needed
# to run the app, and some of it (specs, docs) would otherwise bloat every
# layer that COPYs the whole tree.

.git
.github

# Local dev/agent tooling — not part of the shipped app.
.claude
.clinerules
.cursor
.opencode
.windsurf

# Tests, docs, screenshots — dev-time only.
spec
docs

# Runtime state that shouldn't be baked into an image.
log
tmp
storage/*

# Local secrets/config — never in a built image; production reads these
# from ENV/mounted secrets instead (see Dockerfile header).
.env
.env.*
config/master.key

# Bundler/asset build artifacts — the image builds its own.
.bundle
vendor/bundle
public/assets
app/assets/builds/*

.DS_Store
*.log
