<!DOCTYPE html>
<html lang="en">
  <head>
    <title><%= content_for(:title) || "counta.click" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="Counta">
    <meta name="mobile-web-app-capable" content="yes">
    <meta name="webauthn-rp-id" content="<%= Rails.configuration.x.webauthn_rp_id %>">
    <meta name="signed-in" content="<%= current_account.present? %>">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%= stylesheet_link_tag :app %>
    <%= javascript_importmap_tags %>
  </head>

  <body>
    <%= yield %>
  </body>
</html>
