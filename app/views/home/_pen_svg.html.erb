<%# Canonical pen graphic — ported from assets/counta-pen.svg (see its header
    comment for the dynamic hooks: theme CSS vars, #product-name,
    #product-strength, #dose-value, #piston-assembly transform, #label-front /
    #label-back flip). %>
<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 220 660" class="counta-pen" id="pen-svg" role="img" aria-labelledby="pen-title"
     style="--c-body:#F2F1EE; --c-body-dark:#D9D8D4; --c-accent:#7FD1C8; --c-label:#FFFFFF; --c-text:#123B6D; --c-liquid:#F2FAF9; --c-button:#C9C8C4; --c-button-detail:#8F8E8A; --c-neck:#E8E4DD; --c-scale:#26324B; --c-piston:#8E959F; --c-rod:#5A616C;">
  <title id="pen-title">Your pen, live view</title>
  <defs>
    <linearGradient id="cyl-shade" x1="0" y1="0" x2="1" y2="0">
      <stop offset="0" stop-color="#fff" stop-opacity=".5"/><stop offset=".18" stop-color="#fff" stop-opacity=".15"/>
      <stop offset=".45" stop-color="#fff" stop-opacity="0"/><stop offset=".72" stop-color="#000" stop-opacity=".08"/>
      <stop offset="1" stop-color="#000" stop-opacity=".25"/>
    </linearGradient>
    <linearGradient id="glass-shade" x1="0" y1="0" x2="1" y2="0">
      <stop offset="0" stop-color="#fff" stop-opacity=".65"/><stop offset=".2" stop-color="#fff" stop-opacity=".1"/>
      <stop offset=".55" stop-color="#fff" stop-opacity="0"/><stop offset="1" stop-color="#000" stop-opacity=".12"/>
    </linearGradient>
    <clipPath id="cartridge-clip"><rect x="82" y="384" width="56" height="178" rx="6"/></clipPath>
  </defs>
  <g id="pen">
    <g id="dose-button">
      <rect id="button-face" x="80" y="22" width="60" height="54" rx="14" fill="var(--c-button)" stroke="rgba(0,0,0,.25)"/>
      <g id="button-lines" fill="var(--c-button-detail)">
        <rect x="102" y="32" width="5" height="34" rx="2.5"/><rect x="113" y="32" width="5" height="34" rx="2.5"/>
      </g>
      <rect id="button-stem" x="86" y="74" width="48" height="18" fill="var(--c-body-dark)" stroke="rgba(0,0,0,.2)"/>
    </g>
    <g id="dose-selector">
      <rect x="70" y="92" width="80" height="56" rx="8" fill="var(--c-body-dark)" stroke="rgba(0,0,0,.25)"/>
      <g id="selector-ribs" stroke="rgba(0,0,0,.22)" stroke-width="2">
        <line x1="80" y1="98" x2="80" y2="142"/><line x1="90" y1="98" x2="90" y2="142"/>
        <line x1="100" y1="98" x2="100" y2="142"/><line x1="110" y1="98" x2="110" y2="142"/>
        <line x1="120" y1="98" x2="120" y2="142"/><line x1="130" y1="98" x2="130" y2="142"/>
        <line x1="140" y1="98" x2="140" y2="142"/>
      </g>
    </g>
    <rect id="body-shell" x="74" y="148" width="72" height="230" fill="var(--c-body)" stroke="rgba(0,0,0,.2)"/>
    <g id="dose-counter">
      <rect id="dose-pointer" x="107.5" y="154" width="5" height="16" rx="2.5" fill="#fff" stroke="rgba(0,0,0,.3)"/>
      <rect id="counter-window" x="88" y="176" width="44" height="32" rx="4" fill="#fff" stroke="rgba(0,0,0,.35)" stroke-width="1.5"/>
      <text id="dose-value" x="110" y="199" text-anchor="middle" font-family="system-ui,sans-serif" font-size="19" font-weight="700" fill="#1F2733">0</text>
    </g>
    <g id="label">
      <rect id="label-bg" x="79" y="228" width="62" height="142" rx="6" fill="var(--c-label)" stroke="rgba(0,0,0,.12)"/>
      <path id="label-stripe-top" d="M 79 234 Q 79 228 85 228 L 135 228 Q 141 228 141 234 L 141 239 L 79 239 Z" fill="var(--c-accent)"/>
      <path id="label-stripe-bottom" d="M 79 362 L 141 362 L 141 364 Q 141 370 135 370 L 85 370 Q 79 370 79 364 Z" fill="var(--c-accent)"/>
      <g id="label-front">
        <text id="product-name" transform="translate(97, 248) rotate(90)" font-family="system-ui,sans-serif"
              font-size="24" font-weight="700" font-style="italic" fill="var(--c-text)">—</text>
        <text id="product-strength" transform="translate(126, 248) rotate(90)" font-family="system-ui,sans-serif"
              font-size="11" font-weight="500" fill="#5A616C"></text>
      </g>
      <g id="label-back">
        <text id="label-batch" transform="translate(102, 248) rotate(90)" font-family="ui-monospace,monospace"
              font-size="13" font-weight="700" fill="#3a4150">LOT —</text>
        <text id="label-expiry" transform="translate(124, 248) rotate(90)" font-family="ui-monospace,monospace"
              font-size="13" font-weight="700" fill="#3a4150">EXP —</text>
      </g>
    </g>
    <g id="cartridge-holder">
      <rect id="holder-shell" x="74" y="378" width="72" height="184" rx="4" fill="#EDF1F5" stroke="#C2CCD6" stroke-width="1.5"/>
      <rect id="cartridge-glass" x="82" y="384" width="56" height="178" rx="6" fill="#FBFDFF" stroke="#C2CCD6"/>
      <g clip-path="url(#cartridge-clip)">
        <g id="piston-assembly">
          <rect id="liquid" x="82" y="402" width="56" height="300" fill="var(--c-liquid)"/>
          <rect id="piston" x="82" y="384" width="56" height="18" rx="4" fill="var(--c-piston)" stroke="rgba(0,0,0,.28)"/>
          <rect x="86" y="387" width="10" height="12" rx="3" fill="#fff" opacity=".3"/>
          <rect id="piston-rod" x="103" y="84" width="14" height="300" fill="var(--c-rod)"/>
          <rect x="105.5" y="84" width="3" height="300" fill="#fff" opacity=".25"/>
        </g>
      </g>
      <g id="insulin-scale" stroke="var(--c-scale)" stroke-width="2" stroke-linecap="round">
        <line x1="76" y1="394" x2="84" y2="394"/><line x1="76" y1="416" x2="90" y2="416"/>
        <line x1="76" y1="438" x2="84" y2="438"/><line x1="76" y1="460" x2="90" y2="460"/>
        <line x1="76" y1="482" x2="84" y2="482"/><line x1="76" y1="504" x2="90" y2="504"/>
        <line x1="76" y1="526" x2="84" y2="526"/><line x1="76" y1="548" x2="90" y2="548"/>
      </g>
      <rect x="82" y="384" width="56" height="178" rx="6" fill="url(#glass-shade)" pointer-events="none"/>
    </g>
    <g id="needle-mount">
      <path id="shoulder" d="M 74 562 L 146 562 L 146 568 Q 146 574 139 575 L 125 577 L 95 577 L 81 575 Q 74 574 74 568 Z"
            fill="var(--c-neck)" stroke="rgba(0,0,0,.18)"/>
      <rect id="neck" x="95" y="576" width="30" height="26" rx="3" fill="var(--c-neck)" stroke="rgba(0,0,0,.18)"/>
      <g id="neck-threads" stroke="rgba(0,0,0,.22)" stroke-width="1.5">
        <line x1="97" y1="582" x2="123" y2="584"/><line x1="97" y1="588" x2="123" y2="590"/><line x1="97" y1="594" x2="123" y2="596"/>
      </g>
      <rect id="septum" x="99" y="602" width="22" height="16" rx="5" fill="#9AA1AB" stroke="rgba(0,0,0,.25)"/>
      <rect x="103" y="605" width="6" height="10" rx="3" fill="#fff" opacity=".35"/>
      <rect x="95" y="576" width="30" height="42" rx="3" fill="url(#cyl-shade)" pointer-events="none"/>
    </g>
    <g id="shading" pointer-events="none">
      <rect x="80" y="22" width="60" height="70" rx="14" fill="url(#cyl-shade)"/>
      <rect x="70" y="92" width="80" height="56" rx="8" fill="url(#cyl-shade)"/>
      <rect x="74" y="148" width="72" height="230" fill="url(#cyl-shade)"/>
      <rect x="74" y="378" width="72" height="184" rx="4" fill="url(#cyl-shade)" opacity=".55"/>
    </g>
  </g>
</svg>
