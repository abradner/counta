<div class="app">
  <header class="top">
    <div class="logo">counta<span>.click</span></div>
    <%# Multi-pen switcher: a real <select> (docs/design-notes.md "Multi-pen") %>
    <select class="pen-chip" id="chip" aria-label="<%= t('ui.header.pens') %>" hidden></select>
    <button class="iconbtn account-btn" id="account-btn" aria-label="<%= t('ui.header.account') %>" hidden>☰</button>
  </header>

  <%# ============ LANDING (signed out) ============ %>
  <section id="landing-screen" hidden>
    <div class="card">
      <h2><%= t('ui.landing.title') %></h2>
      <p><%= t('ui.landing.body') %></p>
      <div style="margin-top:16px">
        <button class="btn" id="landing-create"><%= t('ui.landing.create') %></button>
        <button class="btn secondary" id="landing-signin"><%= t('ui.landing.sign_in') %></button>
        <button class="btn secondary" id="landing-recover"><%= t('ui.landing.recover') %></button>
      </div>
      <%# Push notifications aren't built yet, so there is nothing for this to
          clear. It stays visible (and honest) rather than claiming a deletion
          that doesn't happen — see docs/data-privacy.md "device hygiene". %>
      <p class="hint" style="margin-top:14px">
        <%= t('ui.landing.push_note') %>
        <button class="linklike" id="landing-flush"><%= t('ui.landing.push_check') %></button></p>
    </div>
    <div id="landing-error" class="warn red" role="alert" hidden></div>
  </section>

  <%# ============ UNLOCK (session exists, DEK not in memory) ============ %>
  <section id="unlock-screen" hidden>
    <div class="card">
      <h2><%= t('ui.unlock.title') %></h2>
      <p><%= t('ui.unlock.body') %></p>
      <button class="btn" id="unlock-btn"><%= t('ui.unlock.submit') %></button>
      <button class="btn secondary" id="unlock-signout"><%= t('ui.unlock.sign_out') %></button>
      <div id="unlock-error" class="warn red" role="alert" hidden style="margin-top:10px"></div>
    </div>
  </section>

  <%# ============ RECOVERY ============ %>
  <section id="recovery-screen" hidden>
    <div class="card">
      <h2><%= t('ui.recovery.title') %></h2>
      <p><%= t('ui.recovery.body') %></p>
      <label for="rec-file"><%= t('ui.recovery.file') %></label>
      <input type="file" id="rec-file" accept="application/json,.json,.txt">
      <label for="rec-account"><%= t('ui.recovery.account_id') %></label>
      <input type="text" id="rec-account" autocomplete="off" spellcheck="false" placeholder="<%= t('ui.recovery.account_id_placeholder') %>">
      <label for="rec-words"><%= t('ui.recovery.words') %></label>
      <textarea id="rec-words" rows="3" autocomplete="off" spellcheck="false" autocapitalize="none"></textarea>
      <div style="margin-top:14px">
        <button class="btn" id="rec-submit"><%= t('ui.recovery.submit') %></button>
        <button class="btn secondary" id="rec-cancel"><%= t('ui.recovery.back') %></button>
      </div>
      <div id="rec-error" class="warn red" role="alert" hidden style="margin-top:10px"></div>
    </div>
  </section>

  <%# ============ MAIN APP ============ %>
  <main id="app-screen" hidden>
    <div class="pen-col">
      <%= render "pen_svg" %>
      <%# Visually redundant — the card next to it already says which mode
          you're in — but flipping the pen IS the mode transition, so screen
          reader users still get it announced. %>
      <div class="visually-hidden" id="pen-caption" aria-live="polite"><%= t('client.pen.front') %></div>
    </div>

    <div class="panel-col">
      <section class="card" id="setup-card" hidden>
        <h2><%= t('ui.setup.title') %>
          <button class="iconbtn" id="info-btn" aria-label="<%= t('ui.setup.why') %>">i</button>
        </h2>
        <label for="f-product"><%= t('ui.setup.product') %></label>
        <select id="f-product"></select>
        <div id="custom-name-wrap" hidden>
          <label for="f-name"><%= t('ui.setup.custom_name') %></label>
          <input type="text" id="f-name" autocomplete="off" placeholder="<%= t('ui.setup.custom_name_placeholder') %>">
          <%# counta can't know an unlisted pen's counter, and guessing "shows
              numbers" would have it tell people to dial to a number their pen
              may never display. Ask; default to the answer that claims least. %>
          <label for="f-counter-style"><%= t('ui.setup.counter_style') %></label>
          <select id="f-counter-style">
            <option value="progress"><%= t('ui.setup.counter_style_progress') %></option>
            <option value="numeric"><%= t('ui.setup.counter_style_numeric') %></option>
          </select>
          <p class="hint"><%= t('ui.setup.counter_style_hint') %></p>
        </div>
        <label for="f-capacity"><%= t('ui.setup.capacity') %></label>
        <select id="f-capacity"></select>
        <div id="custom-cap-wrap" hidden>
          <div class="row">
            <div><label for="f-cap-units"><%= t('ui.setup.capacity_units') %></label><input type="number" id="f-cap-units" inputmode="decimal" placeholder="9.6"></div>
            <div><label for="f-cap-unitname"><%= t('ui.setup.capacity_unit_name') %></label><input type="text" id="f-cap-unitname" placeholder="mg"></div>
          </div>
        </div>
        <label for="f-clicks"><%= t('ui.setup.total_clicks') %></label>
        <input type="number" id="f-clicks" inputmode="numeric">
        <p class="hint" id="clicks-hint"><%= t('ui.setup.total_clicks_hint') %></p>
        <div class="row">
          <div><label for="f-batch"><%= t('ui.setup.batch') %></label><input type="text" id="f-batch" autocomplete="off" placeholder="LP1234"></div>
          <div><label for="f-expiry"><%= t('ui.setup.expiry') %></label><input type="month" id="f-expiry"></div>
        </div>
        <label for="f-freq"><%= t('ui.setup.frequency') %></label>
        <select id="f-freq">
          <option value="7"><%= t('ui.setup.frequency_weekly') %></option>
          <option value="1"><%= t('ui.setup.frequency_daily') %></option>
          <option value="3.5"><%= t('ui.setup.frequency_twice_weekly') %></option>
          <option value="14"><%= t('ui.setup.frequency_fortnightly') %></option>
        </select>

        <%# Dose plan (#21). Hidden entirely for a product with no published
            schedule and no plan already in progress — an empty control would
            imply a feature that isn't reachable from here. %>
        <div id="plan-wrap" hidden>
          <label for="f-plan"><%= t('ui.setup.plan') %></label>
          <select id="f-plan"></select>
          <p class="hint"><%= t('ui.setup.plan_jurisdiction') %></p>
          <%# Almost nobody transcribing a published escalation is on week one
              — most people find counta partway up the ramp. Asking costs one
              select for them and nothing at all for someone actually
              starting, since "just starting" is the default. %>
          <div id="plan-progress-wrap" hidden>
            <label for="f-plan-progress"><%= t('ui.setup.plan_progress') %></label>
            <select id="f-plan-progress"></select>
            <div id="plan-prior-wrap" hidden>
              <label for="f-plan-prior" id="plan-prior-label"></label>
              <input type="number" id="f-plan-prior" inputmode="numeric" min="0" step="1" value="0"
                     aria-describedby="plan-prior-hint">
              <p class="hint" id="plan-prior-hint"><%= t('ui.setup.plan_prior_hint') %></p>
            </div>
            <p class="hint" id="plan-position" hidden></p>
          </div>
          <div id="plan-start-wrap" hidden>
            <label for="f-plan-start"><%= t('ui.setup.plan_started') %></label>
            <input type="date" id="f-plan-start">
            <p class="hint"><%= t('ui.setup.plan_started_hint') %></p>
          </div>
          <%# Steps are rendered by app.js and are read-only in this release:
              editing a ladder step by step is not built yet, and the hint
              below says so rather than letting the UI imply otherwise. %>
          <ul class="plan-steps" id="plan-summary" hidden></ul>
          <p class="hint" id="plan-setup-source" hidden></p>
          <p class="hint"><%= t('ui.setup.plan_custom_pending') %></p>
        </div>

        <div style="margin-top:16px">
          <button class="btn" id="save-pen"><%= t('ui.setup.save') %></button>
          <button class="btn secondary" id="cancel-setup" hidden><%= t('ui.setup.cancel') %></button>
          <button class="btn secondary" id="archive-pen-edit" hidden><%= t('ui.setup.archive') %></button>
          <button class="btn danger" id="trash-pen-edit" hidden><%= t('ui.setup.trash') %></button>
        </div>
      </section>

      <section class="card" id="dose-card" hidden>
        <h2 id="dose-h"><%= t('ui.dose.title') %></h2>
        <div id="archived-note" class="warn amber" hidden>
          <span aria-hidden="true">🗄</span><span id="archived-note-text"></span>
        </div>
        <div id="dose-entry">
          <div class="seg" role="group" aria-label="<%= t('ui.dose.units_group') %>">
            <button id="seg-units" aria-pressed="true">mg</button>
            <button id="seg-clicks" aria-pressed="false"><%= t('ui.dose.clicks') %></button>
          </div>
          <div class="chips" id="chips" role="group" aria-label="<%= t('ui.dose.common_doses') %>"></div>
          <div class="doserow">
            <button class="step" id="minus" aria-label="<%= t('ui.dose.less') %>">−</button>
            <input id="f-dose" type="number" inputmode="decimal" aria-label="<%= t('ui.dose.amount') %>" step="any">
            <button class="step" id="plus" aria-label="<%= t('ui.dose.more') %>">+</button>
          </div>
          <div class="readout" aria-live="polite" id="readout">
            <div class="big" id="readout-big"></div>
            <div class="sub" id="readout-sub"></div>
          </div>

          <%# Dose plan (#21). Facts about this user's own data, plus the
              document the plan was transcribed from. counta never paraphrases
              clinical guidance here: the Australian and US product information
              give different missed-dose rules, so a paraphrase would be wrong
              in one of them. %>
          <div id="plan-block" hidden>
            <p class="plan-line" id="plan-line" aria-live="polite"></p>
            <div id="plan-dial-warn" class="warn amber" hidden>
              <span aria-hidden="true">⚠️</span><span id="plan-dial-warn-text"></span>
            </div>
            <div id="plan-gap" class="warn amber" hidden>
              <span aria-hidden="true">⚠️</span>
              <span>
                <span id="plan-gap-text"></span>
                <a id="plan-gap-source" target="_blank" rel="noopener noreferrer" hidden></a>
                <button class="linklike" id="plan-gap-edit"><%= t('ui.dose.plan_edit') %></button>
              </span>
            </div>
            <p class="hint" id="plan-source" hidden></p>
          </div>

          <label for="f-date"><%= t('ui.dose.date') %></label>
          <input type="date" id="f-date">
          <div style="margin-top:14px">
            <button class="btn" id="dose-now"><%= t('client.dose.now') %></button>
          </div>
          <div id="warnings" aria-live="polite"></div>
          <div class="stats" id="stats"></div>
        </div>
        <h2 style="margin-top:16px"><%= t('ui.dose.recent') %></h2>
        <ul class="history" id="history"><li class="empty"><%= t('client.history.empty') %></li></ul>
        <div style="margin-top:16px">
          <button class="btn secondary" id="archive-pen" hidden><%= t('ui.dose.archive') %></button>
          <button class="btn secondary" id="unarchive-pen" hidden><%= t('ui.dose.unarchive') %></button>
          <button class="btn secondary" id="export-ics"><%= t('ui.dose.export') %></button>
          <button class="btn secondary" id="edit-pen"><%= t('ui.dose.edit') %></button>
          <button class="btn danger" id="trash-pen" hidden><%= t('ui.dose.trash') %></button>
        </div>
      </section>

      <footer><%= t('ui.footer.privacy') %><br>
        <%= t('ui.footer.disclaimer') %></footer>
    </div>
  </main>

  <%# ============ ACCOUNT & DATA PANEL ============ %>
  <section id="account-screen" hidden>
    <div class="card">
      <h2><%= t('ui.account.title') %></h2>
      <p class="hint"><%= t('ui.account.account_id') %> <code id="acct-id"></code></p>
      <h2 style="margin-top:14px"><%= t('ui.account.archived_pens') %></h2>
      <ul class="history" id="archived-list"></ul>
      <h2 style="margin-top:18px"><%= t('ui.account.passkeys') %></h2>
      <ul class="history" id="passkey-list"></ul>
      <p class="hint" id="add-passkey-hint"><%= t('ui.account.add_passkey_hint') %></p>
      <button class="btn secondary" id="add-passkey"><%= t('ui.account.add_passkey') %></button>
      <h2 style="margin-top:18px"><%= t('ui.account.recovery_kit') %></h2>
      <p class="hint" id="kit-status"><%= t('ui.account.recovery_kit_status') %></p>
      <h2 style="margin-top:18px"><%= t('ui.account.danger') %></h2>
      <button class="btn danger" id="delete-account"><%= t('ui.account.delete') %></button>
      <div style="margin-top:18px">
        <button class="btn secondary" id="account-back"><%= t('ui.account.back') %></button>
        <button class="btn secondary" id="sign-out"><%= t('ui.account.sign_out') %></button>
      </div>
      <div id="account-error" class="warn red" role="alert" hidden style="margin-top:10px"></div>
    </div>
  </section>
</div>

<%# ============ DIALOGS ============ %>

<dialog id="disclaimer-dlg" aria-labelledby="disclaimer-title">
  <h3 id="disclaimer-title"><%= t('ui.disclaimer.title') %></h3>
  <p><%= t('ui.disclaimer.lead_html').html_safe %></p>
  <p><%= t('ui.disclaimer.data') %></p>
  <button class="btn" id="disclaimer-accept"><%= t('ui.disclaimer.accept') %></button>
  <button class="btn secondary" id="disclaimer-cancel"><%= t('ui.disclaimer.cancel') %></button>
</dialog>

<dialog id="prf-dlg" aria-labelledby="prf-title">
  <h3 id="prf-title"><%= t('ui.prf.title') %></h3>
  <p><%= t('ui.prf.body') %></p>
  <button class="btn" id="prf-retry"><%= t('ui.prf.retry') %></button>
  <button class="btn secondary" id="prf-cancel"><%= t('ui.prf.cancel') %></button>
</dialog>

<dialog id="gesture-dlg" aria-labelledby="gesture-title">
  <h3 id="gesture-title"><%= t('ui.gesture.title') %></h3>
  <p><%= t('ui.gesture.body') %></p>
  <button class="btn" id="gesture-continue"><%= t('ui.gesture.continue') %></button>
</dialog>

<dialog id="kit-dlg" aria-labelledby="kit-title">
  <h3 id="kit-title"><%= t('ui.kit.title') %></h3>
  <p class="kit-warning"><%= t('ui.kit.warning_html').html_safe %></p>
  <a class="btn" id="kit-download" download="counta-recovery-kit.json"><%= t('ui.kit.download') %></a>
  <p class="hint" style="margin-top:8px"><%= t('ui.kit.download_hint') %></p>
  <details class="kit-details">
    <summary id="kit-words-toggle"><%= t('ui.kit.show_words') %></summary>
    <p class="hint"><%= t('ui.kit.account_hint') %></p>
    <code class="kit-account" id="kit-account"></code>
    <ol class="kit-words" id="kit-words"></ol>
  </details>
  <label class="kit-confirm"><input type="checkbox" id="kit-saved-check">
    <%= t('ui.kit.confirm') %></label>
  <button class="btn" id="kit-done" disabled><%= t('ui.kit.continue') %></button>
</dialog>

<dialog id="confirm-dlg" aria-labelledby="confirm-title">
  <h3 id="confirm-title"><%= t('ui.confirm_dose.title') %></h3>
  <div class="confirm-big" id="confirm-clicks"></div>
  <div class="confirm-sub" id="confirm-mg"></div>
  <button class="btn" id="confirm-yes"><%= t('ui.confirm_dose.accept') %></button>
  <button class="btn secondary" id="confirm-no"><%= t('ui.confirm_dose.cancel') %></button>
</dialog>

<dialog id="info-dlg" aria-labelledby="info-title">
  <h3 id="info-title"><%= t('ui.info.title') %></h3>
  <p><%= t('ui.info.expiry_html').html_safe %></p>
  <p><%= t('ui.info.storage') %></p>
  <button class="btn secondary" id="info-close"><%= t('ui.info.close') %></button>
</dialog>

<dialog id="trash-dlg" aria-labelledby="trash-title">
  <h3 id="trash-title"><%= t('ui.trash.title') %></h3>
  <p><%= t('ui.trash.body') %></p>
  <button class="btn danger" id="trash-yes"><%= t('ui.trash.confirm') %></button>
  <button class="btn secondary" id="trash-no"><%= t('ui.trash.cancel') %></button>
</dialog>

<dialog id="ics-dlg" aria-labelledby="ics-title">
  <h3 id="ics-title"><%= t('ui.ics.title') %></h3>
  <p><%= t('ui.ics.body') %></p>
  <p><%= t('ui.ics.caveat_html').html_safe %></p>
  <button class="btn" id="ics-yes"><%= t('ui.ics.confirm') %></button>
  <button class="btn secondary" id="ics-no"><%= t('ui.ics.cancel') %></button>
</dialog>

<dialog id="delete-dlg" aria-labelledby="delete-title">
  <h3 id="delete-title"><%= t('ui.delete.title') %></h3>
  <p><%= t('ui.delete.body') %></p>
  <button class="btn danger" id="delete-yes"><%= t('ui.delete.confirm') %></button>
  <button class="btn secondary" id="delete-no"><%= t('ui.delete.cancel') %></button>
</dialog>

<div class="visually-hidden" aria-live="polite" id="sr-live"></div>
