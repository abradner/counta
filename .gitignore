# --- Universal ---
.DS_Store
Thumbs.db
*.log
tmp/
*.swp
*.swo

# Local agent config (per-machine permissions — never shared)
.claude/settings.local.json

# Session context handoffs (park-context skill) — local working state, and they
# can carry session detail that shouldn't land in this repo's history
.claude/handoffs/

# Env files — commit templates (.env.template*), never real values
.env
.env.*
!.env.template
!.env.template.*

# IDE local state (uncomment if unwanted in this repo)
# .idea/
# .vscode/

# --- Ruby/Rails ---
/log/*
/storage/*
/public/assets
.bundle/
vendor/bundle

# Decrypts config/credentials.yml.enc — a real secret. This repo is public;
# never commit it. (It was absent from this list until the Rails app was
# scaffolded, and `rails new` writes the key straight into config/.)
/config/master.key

.byebug_history
/app/assets/builds/*
